{
  "name": "remove-white-spaces",
  "displayName": "Remove Empty Spaces",
  "description": "Remove leading and trailing whitespace from the current file",
  "version": "1.0.0",
  "publisher": "adir-ratzon",
  "repository": {
    "type": "git",
    "url": "https://github.com/adir-ratzon/vscode-remove-white-spaces"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:removeWhiteSpaces.removeLeading",
    "onCommand:removeWhiteSpaces.removeTrailing",
    "onCommand:removeWhiteSpaces.removeBoth"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "removeWhiteSpaces.removeLeading",
        "title": "Remove Leading Spaces"
      },
      {
        "command": "removeWhiteSpaces.removeTrailing",
        "title": "Remove Trailing Spaces"
      },
      {
        "command": "removeWhiteSpaces.removeBoth",
        "title": "Remove Both Leading and Trailing Spaces"
      }
    ],
    "keybindings": [
      {
        "command": "removeWhiteSpaces.removeLeading",
        "key": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "removeWhiteSpaces.removeTrailing",
        "key": "cmd+alt+t",
        "when": "editorTextFocus"
      },
      {
        "command": "removeWhiteSpaces.removeBoth",
        "key": "cmd+alt+e",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
} 